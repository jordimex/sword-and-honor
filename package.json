{
  "name": "sword-and-honor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "devvit-cli playtest",
    "web:dev": "vite --configLoader runner",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --configLoader runner",
    "build:server": "vite build --config vite.server.config.ts --configLoader runner",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "npm run type-check",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@devvit/web": "^0.14.1",
    "@hono/node-server": "^1.19.9",
    "hono": "^4.11.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@devvit/cli": "^0.14.2",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
